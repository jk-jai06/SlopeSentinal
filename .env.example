# =========================================================================
# SlopeSentinel — Environment Variable Configuration Template
# Copy this file to '.env' and fill in your environment-specific values.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# =========================================================================

# Application Environment Mode ('development', 'staging', 'production')
ENVIRONMENT=development

# JWT Authentication Secret Key (Required for session token cryptographic signing)
# Generate a strong 32-byte secret key using Python:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters_here

# JWT Algorithm (Default: HS256)
ALGORITHM=HS256

# Access Token Expiry in Minutes (Default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma separated origins allowed to make API requests)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database Connection URL (Defaults to local SQLite if left unset)
# SQLite: sqlite:///./landslide.db
# PostgreSQL: postgresql://username:password@localhost:5432/slopesentinel_db
DATABASE_URL=sqlite:///./landslide.db

# Frontend API Base URL (Used when creating frontend/.env)
# VITE_API_BASE_URL=http://127.0.0.1:8000
